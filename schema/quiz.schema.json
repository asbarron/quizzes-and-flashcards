{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asbarron/quizzes-and-flashcards/schema/quiz.schema.json",
  "title": "Multiple-choice quiz",
  "description": "A quiz file is an array of multiple-choice questions.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["q", "options", "answer", "explanation"],
    "additionalProperties": false,
    "properties": {
      "q": {"type": "string", "minLength": 1, "description": "Question text."},
      "options": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "minItems": 2,
        "maxItems": 6,
        "uniqueItems": true
      },
      "answer": {"type": "integer", "minimum": 0, "description": "Zero-based index of the correct option."},
      "explanation": {"type": "string", "minLength": 1},
      "section": {"type": "string", "description": "Optional source reference, such as a book section."}
    }
  }
}
